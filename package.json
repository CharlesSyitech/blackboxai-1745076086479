    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.15.3",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.13",
    "typescript": "5.8.3"
  }
}
