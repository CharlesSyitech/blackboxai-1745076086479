{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Syitech Group — design tokens. Primitives are placeholders until the official brand charter is supplied; only the `primitive` group changes on rebrand.",
  "$version": "0.1.0-draft",
  "primitive": {
    "color": {
      "navy": {
        "50":  { "$type": "color", "$value": "#EEF3FA" },
        "100": { "$type": "color", "$value": "#D6E2F2" },
        "200": { "$type": "color", "$value": "#AEC5E5" },
        "300": { "$type": "color", "$value": "#7C9FD1" },
        "400": { "$type": "color", "$value": "#4C77B8" },
        "500": { "$type": "color", "$value": "#2A5698" },
        "600": { "$type": "color", "$value": "#1B4079" },
        "700": { "$type": "color", "$value": "#12305D" },
        "800": { "$type": "color", "$value": "#0B2142" },
        "900": { "$type": "color", "$value": "#061428" }
      },
      "ink": {
        "700": { "$type": "color", "$value": "#2B3240" },
        "800": { "$type": "color", "$value": "#12151B" },
        "900": { "$type": "color", "$value": "#060B14" }
      },
      "neutral": {
        "0":   { "$type": "color", "$value": "#FFFFFF" },
        "50":  { "$type": "color", "$value": "#F7F8FA" },
        "100": { "$type": "color", "$value": "#EDEFF3" },
        "200": { "$type": "color", "$value": "#D9DDE4" },
        "400": { "$type": "color", "$value": "#9AA3B0" },
        "600": { "$type": "color", "$value": "#5A6472" },
        "800": { "$type": "color", "$value": "#2B3240" }
      },
      "amber": {
        "100": { "$type": "color", "$value": "#FDF0DA" },
        "300": { "$type": "color", "$value": "#F2C177" },
        "500": { "$type": "color", "$value": "#E39A2B" },
        "600": { "$type": "color", "$value": "#C67F16" },
        "700": { "$type": "color", "$value": "#9A5B00" }
      },
      "teal": {
        "300": { "$type": "color", "$value": "#5FCFCB" },
        "500": { "$type": "color", "$value": "#0FA3A3" },
        "700": { "$type": "color", "$value": "#0A7B7B" }
      },
      "state": {
        "success": { "$type": "color", "$value": "#12805C" },
        "warning": { "$type": "color", "$value": "#9A5B00" },
        "error":   { "$type": "color", "$value": "#B3261E" },
        "info":    { "$type": "color", "$value": "#1B4079" }
      }
    },
    "space": {
      "0":  { "$type": "dimension", "$value": "0px" },
      "1":  { "$type": "dimension", "$value": "4px" },
      "2":  { "$type": "dimension", "$value": "8px" },
      "3":  { "$type": "dimension", "$value": "12px" },
      "4":  { "$type": "dimension", "$value": "16px" },
      "5":  { "$type": "dimension", "$value": "24px" },
      "6":  { "$type": "dimension", "$value": "32px" },
      "7":  { "$type": "dimension", "$value": "40px" },
      "8":  { "$type": "dimension", "$value": "48px" },
      "9":  { "$type": "dimension", "$value": "64px" },
      "10": { "$type": "dimension", "$value": "72px" },
      "11": { "$type": "dimension", "$value": "80px" },
      "12": { "$type": "dimension", "$value": "96px" },
      "13": { "$type": "dimension", "$value": "128px" },
      "14": { "$type": "dimension", "$value": "160px" },
      "15": { "$type": "dimension", "$value": "200px" }
    },
    "radius": {
      "sm":   { "$type": "dimension", "$value": "4px" },
      "md":   { "$type": "dimension", "$value": "8px" },
      "lg":   { "$type": "dimension", "$value": "12px" },
      "xl":   { "$type": "dimension", "$value": "16px" },
      "full": { "$type": "dimension", "$value": "9999px" }
    },
    "shadow": {
      "xs": { "$type": "shadow", "$value": "0 1px 2px rgba(6,20,40,0.06)" },
      "sm": { "$type": "shadow", "$value": "0 2px 8px rgba(6,20,40,0.06)" },
      "md": { "$type": "shadow", "$value": "0 8px 24px rgba(6,20,40,0.08)" },
      "lg": { "$type": "shadow", "$value": "0 24px 48px rgba(6,20,40,0.12)" }
    },
    "font": {
      "family": {
        "display": { "$type": "fontFamily", "$value": ["Manrope", "Segoe UI", "system-ui", "sans-serif"] },
        "body":    { "$type": "fontFamily", "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "sans-serif"] },
        "mono":    { "$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "SFMono-Regular", "monospace"] }
      },
      "weight": {
        "regular":  { "$type": "fontWeight", "$value": 400 },
        "medium":   { "$type": "fontWeight", "$value": 500 },
        "semibold": { "$type": "fontWeight", "$value": 600 },
        "bold":     { "$type": "fontWeight", "$value": 700 },
        "extrabold":{ "$type": "fontWeight", "$value": 800 }
      }
    },
    "duration": {
      "instant": { "$type": "duration", "$value": "100ms" },
      "fast":    { "$type": "duration", "$value": "150ms" },
      "base":    { "$type": "duration", "$value": "220ms" },
      "slow":    { "$type": "duration", "$value": "400ms" },
      "reveal":  { "$type": "duration", "$value": "600ms" },
      "counter": { "$type": "duration", "$value": "900ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
      "entrance": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] },
      "exit":     { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1] }
    },
    "breakpoint": {
      "xs":  { "$type": "dimension", "$value": "320px" },
      "sm":  { "$type": "dimension", "$value": "375px" },
      "md":  { "$type": "dimension", "$value": "768px" },
      "lg":  { "$type": "dimension", "$value": "1024px" },
      "xl":  { "$type": "dimension", "$value": "1440px" },
      "2xl": { "$type": "dimension", "$value": "1920px" }
    }
  },
  "semantic": {
    "light": {
      "bg":     { "page": "{primitive.color.neutral.0}", "surface": "{primitive.color.neutral.50}", "elevated": "{primitive.color.neutral.0}", "inverse": "{primitive.color.ink.900}" },
      "text":   { "primary": "{primitive.color.navy.900}", "secondary": "{primitive.color.neutral.600}", "tertiary": "{primitive.color.neutral.400}", "accent": "{primitive.color.navy.700}", "inverse": "{primitive.color.neutral.0}" },
      "border": { "subtle": "{primitive.color.neutral.100}", "default": "{primitive.color.neutral.200}", "strong": "{primitive.color.navy.700}" },
      "action": {
        "primary":   { "bg": "{primitive.color.navy.700}", "fg": "{primitive.color.neutral.0}", "bgHover": "{primitive.color.navy.800}" },
        "accent":    { "bg": "{primitive.color.amber.500}", "fg": "{primitive.color.ink.900}", "bgHover": "{primitive.color.amber.600}" },
        "secondary": { "bg": "transparent", "fg": "{primitive.color.navy.700}", "border": "{primitive.color.neutral.200}" }
      },
      "focus":  { "ring": "{primitive.color.amber.600}" }
    },
    "dark": {
      "bg":     { "page": "{primitive.color.ink.900}", "surface": "{primitive.color.navy.900}", "elevated": "{primitive.color.navy.800}", "inverse": "{primitive.color.neutral.0}" },
      "text":   { "primary": "{primitive.color.neutral.0}", "secondary": "{primitive.color.navy.100}", "tertiary": "{primitive.color.navy.300}", "accent": "{primitive.color.amber.300}", "inverse": "{primitive.color.navy.900}" },
      "border": { "subtle": "rgba(255,255,255,0.08)", "default": "rgba(255,255,255,0.16)", "strong": "{primitive.color.amber.500}" },
      "action": {
        "primary":   { "bg": "{primitive.color.amber.500}", "fg": "{primitive.color.ink.900}", "bgHover": "{primitive.color.amber.600}" },
        "accent":    { "bg": "{primitive.color.amber.500}", "fg": "{primitive.color.ink.900}", "bgHover": "{primitive.color.amber.600}" },
        "secondary": { "bg": "transparent", "fg": "{primitive.color.neutral.0}", "border": "rgba(255,255,255,0.24)" }
      },
      "focus":  { "ring": "{primitive.color.amber.300}" }
    }
  },
  "typography": {
    "displayXl": { "family": "display", "weight": 800, "size": "clamp(2.75rem, 1.6rem + 4.6vw, 5rem)",     "lineHeight": 1.05, "letterSpacing": "-0.03em" },
    "display":   { "family": "display", "weight": 700, "size": "clamp(2.25rem, 1.5rem + 3vw, 3.75rem)",    "lineHeight": 1.1,  "letterSpacing": "-0.025em" },
    "h1":        { "family": "display", "weight": 700, "size": "clamp(2rem, 1.4rem + 2.4vw, 3rem)",        "lineHeight": 1.15, "letterSpacing": "-0.02em" },
    "h2":        { "family": "display", "weight": 700, "size": "clamp(1.625rem, 1.2rem + 1.7vw, 2.25rem)", "lineHeight": 1.2,  "letterSpacing": "-0.015em" },
    "h3":        { "family": "display", "weight": 600, "size": "clamp(1.375rem, 1.15rem + 0.9vw, 1.75rem)","lineHeight": 1.3,  "letterSpacing": "-0.01em" },
    "h4":        { "family": "display", "weight": 600, "size": "1.25rem",  "lineHeight": 1.4, "letterSpacing": "0" },
    "bodyLarge": { "family": "body",    "weight": 400, "size": "1.125rem", "lineHeight": 1.7, "letterSpacing": "0" },
    "body":      { "family": "body",    "weight": 400, "size": "1rem",     "lineHeight": 1.7, "letterSpacing": "0" },
    "small":     { "family": "body",    "weight": 400, "size": "0.875rem", "lineHeight": 1.6, "letterSpacing": "0" },
    "caption":   { "family": "body",    "weight": 400, "size": "0.75rem",  "lineHeight": 1.5, "letterSpacing": "0.01em" },
    "overline":  { "family": "mono",    "weight": 500, "size": "0.75rem",  "lineHeight": 1.4, "letterSpacing": "0.12em", "textTransform": "uppercase" },
    "metric":    { "family": "display", "weight": 800, "size": "clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem)", "lineHeight": 1, "letterSpacing": "-0.03em", "fontVariantNumeric": "tabular-nums" }
  },
  "layout": {
    "container": { "narrow": "800px", "content": "1200px", "wide": "1440px" },
    "gutter":    { "mobile": "16px", "tablet": "16px", "desktop": "24px" },
    "pageMargin":{ "mobile": "20px", "tablet": "32px", "laptop": "40px", "desktop": "80px" },
    "sectionPaddingY": { "mobile": "80px", "tablet": "96px", "desktop": "128px", "major": "160px" },
    "zIndex": { "base": 0, "raised": 10, "sticky": 100, "header": 200, "dropdown": 300, "overlay": 400, "modal": 500, "toast": 600, "skipLink": 700 }
  },
  "contrastContract": {
    "$description": "Pairs asserted to meet WCAG 2.2. Enforced by scripts/check-contrast.ts at build time.",
    "text": [
      { "fg": "{primitive.color.navy.900}",   "bg": "{primitive.color.neutral.0}", "min": 4.5 },
      { "fg": "{primitive.color.navy.700}",   "bg": "{primitive.color.neutral.0}", "min": 4.5 },
      { "fg": "{primitive.color.neutral.600}","bg": "{primitive.color.neutral.0}", "min": 4.5 },
      { "fg": "{primitive.color.amber.700}",  "bg": "{primitive.color.neutral.0}", "min": 4.5 },
      { "fg": "{primitive.color.teal.700}",   "bg": "{primitive.color.neutral.0}", "min": 4.5 },
      { "fg": "{primitive.color.neutral.0}",  "bg": "{primitive.color.navy.800}",  "min": 4.5 },
      { "fg": "{primitive.color.neutral.0}",  "bg": "{primitive.color.ink.900}",   "min": 4.5 },
      { "fg": "{primitive.color.ink.900}",    "bg": "{primitive.color.amber.500}", "min": 4.5 },
      { "fg": "{primitive.color.amber.500}",  "bg": "{primitive.color.ink.900}",   "min": 4.5 }
    ],
    "nonText": [
      { "fg": "{primitive.color.teal.500}",   "bg": "{primitive.color.neutral.0}", "min": 3.0 },
      { "fg": "{primitive.color.amber.600}",  "bg": "{primitive.color.neutral.0}", "min": 3.0 }
    ],
    "forbidden": [
      { "fg": "{primitive.color.amber.500}", "bg": "{primitive.color.neutral.0}", "reason": "2.4:1 — never use amber-500 for text on light backgrounds" },
      { "fg": "{primitive.color.teal.500}",  "bg": "{primitive.color.neutral.0}", "reason": "3.1:1 — graphics only, never text" }
    ]
  }
}
